# Copie este arquivo para .env.test (NÃO commitar o .env.test — já está
# no .gitignore junto com o .env normal) e preencha com valores reais.
#
# VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY: os mesmos do seu .env normal.
#
# SUPABASE_SERVICE_ROLE_KEY e ASAAS_WEBHOOK_TOKEN: copie do painel da
# Vercel (Settings → Environment Variables do projeto) — são as mesmas
# chaves que api/*.js já usa em produção. Necessárias pra criar/apagar as
# contas de teste e simular o webhook da Asaas.
#
# ASAAS_SANDBOX=true garante que o teste de pagamento usa o ambiente de
# testes da Asaas, nunca o de produção.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=true
ASAAS_KEY_SANDBOX=
